# Fire Finds interim backend — copy to .env and fill locally.
# Never commit .env or secrets/.

# --- Randmar OAuth (client credentials) ---
# client_id is the Integration key NAME (not a secret UUID).
# Quote values that contain spaces so `shell . .env` works.
# If unset, defaults to "Fire Finds catalog read" (also secrets/randmar_client_id.txt).
RANDMAR_CLIENT_ID="Fire Finds catalog read"
# client_secret lives in a local file (never inline in .env commits).
RANDMAR_CLIENT_SECRET_FILE=/workspace/firefinds/secrets/randmar_api_key.txt
# Optional: directory fallback for client_id / client_secret files.
RANDMAR_SECRETS_DIR=/workspace/firefinds/secrets

RANDMAR_RESELLER_ID=2WQN9V11G
RANDMAR_TOKEN_URL=https://auth.randmar.io/connect/token
RANDMAR_API_BASE=https://api.randmar.io

# Feature gates — all default OFF for safety
LIVE_LISTINGS_ENABLED=false
SUPPLIER_ORDERS_ENABLED=false
EBAY_PRODUCTION_ENABLED=false
EBAY_SANDBOX_PUBLISH_ENABLED=false
EBAY_TRACKING_UPDATES_ENABLED=false

# --- eBay (developer approval may be pending) ---
# EBAY_ENV=sandbox|production  (Sell default = sandbox)
EBAY_ENV=sandbox
# Production app token is used for Browse CA competition when true (default).
EBAY_BROWSE_USE_PRODUCTION=true
EBAY_MARKETPLACE_ID=EBAY_CA
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET_FILE=/workspace/firefinds/secrets/ebay_client_secret.txt
# User OAuth (Sell) — RuName from Developer Portal (alias: EBAY_REDIRECT_URI)
# EBAY_RUNAME=
# EBAY_USER_REFRESH_TOKEN_FILE=/workspace/firefinds/secrets/ebay_user_refresh_token.txt
# Optional sandbox offer overrides (Business Policies must be eligible first)
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_CATEGORY_ID=
# Competition strategy: min_map_median | median | lowest
EBAY_COMPETE_STRATEGY=min_map_median
EBAY_COMPETE_MEDIAN_FACTOR=0.98
EBAY_COMP_TOP_N=10
EBAY_MIN_COMP_LISTINGS=1
# Soft display/export limit only (0 = no limit). NEVER truncates ranked queue.
LISTABLE_EXPORT_LIMIT=0
# Soft eBay account selling-limit placeholder (0 = unlimited). Metadata only.
EBAY_SELLING_LIMIT=0
ALLOW_PROVISIONAL_LISTABLE=true
MONTHLY_DEMAND_BASELINE=4

# --- Shipping quotes (REQUIRED for final listable) ---
# Do NOT assume a marketing flat rate (e.g. $10) is your dealer shipping cost.
# Final profitability uses the 75th percentile of resolved quotes across
# representative CA destinations (Calgary T2P 1J9, Vancouver V6B 1A1,
# Toronto M5H 2N2, Montreal H3B 1A7, Halifax B3J 1S9).
# Read-only endpoints only:
#   POST /V4/Reseller/{id}/Cart/ShippingMethods/{cartName}  (never Cart/Process*)
#   POST /V4/Reseller/{id}/ShippingLabel/Estimate
# If ZERO dests resolve → shipping_status=UNRESOLVED → NOT finally listable.
# Fulfillment later quotes the buyer's actual postal code (not these proxies).
SHIP_QUOTE_ENABLED=true
SHIP_QUOTE_SLEEP_SEC=0.35
# Fallback single-dest fields (ShipToLocation: Name, Street1, Street2, City,
# Province 2-letter, PostalCode, Country CA/US). Used if a caller still quotes
# one address; ranking uses the representative set above.
SHIP_TO_NAME=Fire Finds Estimate
SHIP_TO_STREET1=1 Yonge Street
SHIP_TO_STREET2=
SHIP_TO_CITY=Toronto
SHIP_TO_PROVINCE=ON
SHIP_TO_POSTAL_CODE=M5H 2N2
SHIP_TO_COUNTRY=CA
# SHIP_EST_CAD is ONLY a rough placeholder for the early catalog score_pass
# filter — it is NOT used as true shipping for final listable / ranked queue.
SHIP_EST_CAD=10

# Scoring thresholds (CAD) — early catalog filter
MIN_CONTRIBUTION_PROFIT_CAD=8
MIN_CONTRIBUTION_MARGIN=0.12
STOCK_BUFFER=2
# Fee model for early scoring / listable screening (not a Store requirement).
# Default 13.25% + $0.30 sits between NIS and Store Basic — fine for ranking.
# When eBay CA Basic Store is later chosen, prefer EBAY_FEE_RATE=0.127 and
# model ~$0.40 per-order fee for live P&L (see docs/EBAY_CA_FEE_RECOMMENDATION.md).
# Do NOT flip these to Store rates until Store is actually purchased / authorized.
EBAY_FEE_RATE=0.1325
EBAY_FEE_FIXED=0.30
# When MAP is missing/zero: sell = MSRP_DISCOUNT * MSRP (early score only)
MSRP_DISCOUNT=0.95

# Return-risk heuristics
RETURN_RISK_HEAVY_WEIGHT_LB=30
RETURN_RISK_HIGH_MSRP_CAD=1500
DRY_RUN=true
GLOBAL_KILL_SWITCH=true
TARGET_PROFIT_PCT=0.18
MIN_CONTRIBUTION_MARGIN=0.12
MIN_CONTRIBUTION_PROFIT_CAD=8.00
STOCK_BUFFER=2
CAPACITY_POLICY=balanced
CAPACITY_HEADROOM_PCT=0.05
MONTHLY_ITEM_LIMIT=0
MONTHLY_VALUE_LIMIT_CAD=0
REPRICING_CADENCE_SEC=3600
DISCOVERY_CADENCE_SEC=21600
RANKING_PROFIT_WEIGHT=0.55
RANKING_DEMAND_WEIGHT=0.30
RANKING_COMPETITION_WEIGHT=0.15
RETRY_MAX_ATTEMPTS=5
