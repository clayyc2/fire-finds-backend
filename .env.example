# Fire Finds interim backend — copy to .env and fill locally.
# Never commit .env or secrets/.

# --- Randmar OAuth (client credentials) ---
# client_id is the Integration key NAME (not a secret UUID).
# Quote values that contain spaces so `shell . .env` works.
# If unset, defaults to "Fire Finds catalog read" (also secrets/randmar_client_id.txt).
RANDMAR_CLIENT_ID="Fire Finds catalog read"
# client_secret lives in a local file (never inline in .env commits).
RANDMAR_CLIENT_SECRET_FILE=/workspace/firefinds/secrets/randmar_api_key.txt
# Optional: directory fallback for client_id / client_secret files.
RANDMAR_SECRETS_DIR=/workspace/firefinds/secrets

RANDMAR_RESELLER_ID=2WQN9V11G
RANDMAR_TOKEN_URL=https://auth.randmar.io/connect/token
RANDMAR_API_BASE=https://api.randmar.io

# Feature gates — all default OFF for safety
LIVE_LISTINGS_ENABLED=false
SUPPLIER_ORDERS_ENABLED=false
EBAY_PRODUCTION_ENABLED=false

# Scoring thresholds (CAD)
MIN_CONTRIBUTION_PROFIT_CAD=8
MIN_CONTRIBUTION_MARGIN=0.12
STOCK_BUFFER=2
# Fee placeholders used in contribution profit
EBAY_FEE_RATE=0.1325
EBAY_FEE_FIXED=0.30
SHIP_EST_CAD=10
# When MAP is missing/zero: sell = MSRP_DISCOUNT * MSRP
MSRP_DISCOUNT=0.95
